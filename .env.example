# Postgres (docker-compose maps it to localhost:5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/fugo

# nuxt-auth-utils seals the session cookie with a key derived from this (openssl rand -base64 32)
NUXT_APP_SECRET=

# Admin account, created on server start if it does not exist yet
ADMIN_EMAIL=admin@fugo.test
ADMIN_PASSWORD=

# LLM (DeepSeek, OpenAI-compatible API)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_MS=20000

# Background AI worker
AI_WORKER_INTERVAL_MS=3000
# Demo only: make every AI call fail, to show the failed -> reprocess path
AI_FORCE_FAIL=false

# Public form: max submissions per IP per minute
BRIEF_RATE_LIMIT_PER_MINUTE=5
