# Copy to .env in the repo root on the server and fill in. Never commit it.

# Public hostname served over HTTPS by Caddy (DNS must point to this server).
# Without a domain: <ip-with-dashes>.sslip.io
DOMAIN=

# Postgres password (openssl rand -hex 24). DATABASE_URL is built from it in docker-compose.prod.yml.
POSTGRES_PASSWORD=

# Session cookie key (openssl rand -base64 32)
NUXT_APP_SECRET=

# Admin account, created on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# LLM (DeepSeek, OpenAI-compatible API)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_MS=20000

AI_WORKER_INTERVAL_MS=3000
AI_FORCE_FAIL=false
BRIEF_RATE_LIMIT_PER_MINUTE=5
